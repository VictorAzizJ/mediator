# ============================================
# MEDIATOR ENVIRONMENT CONFIGURATION
# ============================================

# ============================================
# CORE APPLICATION
# ============================================
# Public URL (for magic links and callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Socket.io server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Server port for socket.io
SOCKET_PORT=3001

# CORS Origins (comma-separated for production)
CORS_ORIGINS=http://localhost:3000

# Redis URL (optional - falls back to in-memory)
REDIS_URL=redis://localhost:6379

# ============================================
# AI SERVICES (OpenRouter)
# ============================================
# Get your API key at: https://openrouter.ai/keys
# Required for: Conversation summaries, reflection prompts, trigger detection
# Free credits available for new accounts!
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Override the default model (default: meta-llama/llama-3.1-8b-instruct:free)
# Popular free models:
#   - meta-llama/llama-3.1-8b-instruct:free
#   - google/gemma-2-9b-it:free
#   - mistralai/mistral-7b-instruct:free
# Paid models (higher quality):
#   - anthropic/claude-3.5-sonnet
#   - openai/gpt-4o-mini
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ============================================
# TRANSCRIPTION (Deepgram)
# ============================================
# Get your API key at: https://console.deepgram.com/
# Required for: Real-time speech-to-text, speaker diarization
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ============================================
# EMAIL (Resend)
# ============================================
# Get your API key at: https://resend.com/
# Required for: Magic link authentication, session reports
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Mediator <noreply@yourdomain.com>

# ============================================
# DATABASE (Supabase)
# ============================================
# Get your credentials at: https://supabase.com/dashboard
# Required for: User profiles, session analytics, access codes
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# OPTIONAL SERVICES
# ============================================
# AssemblyAI (alternative transcription - not currently used)
# ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# ============================================
# DEMO ACCESS CODE (Hardcoded fallback)
# ============================================
# Default demo code: MEDIATOR2025
# This works even without Supabase configured
